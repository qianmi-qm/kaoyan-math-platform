<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kaoyan.platform.user.mapper.UserMapper">

  <resultMap id="userMap" type="com.kaoyan.platform.user.entity.User">
    <id property="id" column="id"/>
    <result property="username" column="username"/>
    <result property="passwordHash" column="password_hash"/>
    <result property="createdAt" column="created_at"/>
  </resultMap>

  <sql id="cols">id, username, password_hash, created_at</sql>

  <select id="selectByUsername" resultMap="userMap">
    SELECT <include refid="cols"/>
    FROM `user`
    WHERE username = #{username}
  </select>

  <select id="selectById" resultMap="userMap">
    SELECT <include refid="cols"/>
    FROM `user`
    WHERE id = #{id}
  </select>

  <insert id="insert" parameterType="com.kaoyan.platform.user.entity.User"
          useGeneratedKeys="true" keyProperty="id">
    INSERT INTO `user` (username, password_hash)
    VALUES (#{username}, #{passwordHash})
  </insert>

  <update id="updatePasswordHash">
    UPDATE `user`
    SET password_hash = #{passwordHash}
    WHERE id = #{id}
  </update>
</mapper>
