<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kaoyan.platform.user.mapper.UserMapper">

  <resultMap id="userMap" type="com.kaoyan.platform.user.entity.User">
    <id property="id" column="id"/>
    <result property="username" column="username"/>
    <result property="passwordHash" column="password_hash"/>
    <result property="role" column="role"/>
    <result property="tokenVersion" column="token_version"/>
    <result property="email" column="email"/>
    <result property="emailVerified" column="email_verified"/>
    <result property="createdAt" column="created_at"/>
  </resultMap>

  <sql id="cols">id, username, password_hash, role, token_version, email, email_verified, created_at</sql>

  <select id="selectByUsername" resultMap="userMap">
    SELECT <include refid="cols"/>
    FROM `user`
    WHERE username = #{username}
  </select>

  <select id="selectById" resultMap="userMap">
    SELECT <include refid="cols"/>
    FROM `user`
    WHERE id = #{id}
  </select>

  <select id="selectAll" resultMap="userMap">
    SELECT <include refid="cols"/>
    FROM `user`
    ORDER BY id
  </select>

  <select id="selectByEmail" resultMap="userMap">
    SELECT <include refid="cols"/>
    FROM `user`
    WHERE email = #{email}
  </select>

  <insert id="insert" parameterType="com.kaoyan.platform.user.entity.User"
          useGeneratedKeys="true" keyProperty="id">
    INSERT INTO `user` (username, password_hash, role, email)
    VALUES (#{username}, #{passwordHash}, #{role}, #{email})
  </insert>

  <update id="updateEmail">
    UPDATE `user`
    SET email = #{email}, email_verified = 0
    WHERE id = #{id}
  </update>

  <update id="markEmailVerified">
    UPDATE `user`
    SET email_verified = 1
    WHERE id = #{id}
  </update>

  <update id="updatePasswordHash">
    UPDATE `user`
    SET password_hash = #{passwordHash}, token_version = token_version + 1
    WHERE id = #{id}
  </update>

  <update id="bumpTokenVersion">
    UPDATE `user`
    SET token_version = token_version + 1
    WHERE id = #{id}
  </update>

  <update id="updateRole">
    UPDATE `user`
    SET role = #{role}
    WHERE id = #{id}
  </update>

  <update id="updatePasswordAndRole">
    UPDATE `user`
    SET password_hash = #{passwordHash}, role = #{role},
        token_version = token_version + 1
    WHERE id = #{id}
  </update>

  <update id="clearDemoUser">
    UPDATE `user`
    SET password_hash = NULL, role = 'USER'
    WHERE id = #{id} AND username = 'learner'
  </update>
</mapper>
