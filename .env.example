# 复制为 .env（已被 .gitignore 忽略），docker compose 会自动读取
# 生产/公网环境务必改掉默认值
MYSQL_ROOT_PASSWORD=change-me

# v2 AI 讲解：不填 key 会自动降级为参考解析，不报错
AI_ENABLED=true
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat

# v3 认证：复制后必须替换；示例值会被启动校验拒绝（至少 32 字节）
JWT_SECRET=change-me-to-a-random-secret-at-least-32-bytes
JWT_EXPIRE_HOURS=2
JWT_REFRESH_DAYS=7
# 默认关闭；本地演示设为 true，并自行设置一个非默认强密码
DEMO_USER_ENABLED=false
DEMO_USER_PASSWORD=
# 独立管理员引导：生产必须配置；本地可留空
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_REQUIRED=true
