# 复制为 .env（已被 .gitignore 忽略），docker compose 会自动读取
# 生产/公网环境务必改掉默认值
MYSQL_ROOT_PASSWORD=change-me

# v2 AI 讲解：不填 key 会自动降级为参考解析，不报错
AI_ENABLED=true
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat

# v3 认证：生产必须换成长随机串（至少 32 字节）
JWT_SECRET=change-me-to-a-random-secret-at-least-32-bytes
JWT_EXPIRE_HOURS=24
# 本地演示账号 learner / learner123；生产设 false
DEMO_USER_ENABLED=true
DEMO_USER_PASSWORD=learner123
